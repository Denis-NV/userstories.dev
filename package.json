{
  "name": "ustrs",
  "description": "A pnpm Turborepo-driven monorepo",
  "version": "0.0.0",
  "author": "Denis Nemytov",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@swc/core": "^1.3.103",
    "@turbo/gen": "^1.11.3",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/node": "^20.11.1",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@ustrs/typescript-config": "workspace:*",
    "eslint": "^8.56.0",
    "eslint-config-turbo": "^1.11.3",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-storybook": "^0.6.15",
    "fast-check": "^3.15.0",
    "husky": "^8.0.3",
    "inquirer": "^8.2.6",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "jsonc-parser": "^3.2.0",
    "lint-staged": "^15.2.0",
    "p": "^0.2.0",
    "prettier": "^3.2.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "syncpack": "^12.3.2",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "keywords": [],
  "license": "ISC",
  "lint-staged": {
    "libs/*/src/**/*.{js,jsx,ts,tsx}": [
      "pnpm lint",
      "pnpm format",
      "pnpm syncpack lint"
    ],
    "apps/*/src/**/*.{js,jsx,ts,tsx,}": [
      "pnpm lint",
      "pnpm format",
      "pnpm syncpack lint"
    ]
  },
  "packageManager": "pnpm@9.9.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18",
        "react-dom": "18"
      }
    },
    "overrides": {
      "express>body-parser": "^1.20.3",
      "handlebars": ">=4.7.9",
      "basic-ftp": ">=5.2.2",
      "minimatch": ">=9.0.7",
      "brace-expansion": ">=2.0.2",
      "tar": ">=6.2.1",
      "tar-fs": ">=2.1.4",
      "rollup": ">=4.59.0",
      "@remix-run/router": ">=1.23.2",
      "braces": ">=3.0.3",
      "cross-spawn": ">=7.0.5",
      "dset": ">=3.1.4",
      "effect": ">=3.20.0",
      "flatted": ">=3.4.2",
      "glob": ">=10.5.0",
      "immutable": ">=3.8.3",
      "path-to-regexp": ">=0.1.13",
      "picomatch": ">=2.3.2",
      "validator": ">=13.15.22",
      "ws": ">=8.17.1",
      "@babel/runtime": ">=7.26.10",
      "@babel/helpers": ">=7.26.10",
      "@babel/runtime-corejs3": ">=7.26.10",
      "ajv": ">=6.14.0 <7",
      "diff": ">=4.0.4",
      "esbuild": ">=0.25.0",
      "js-yaml": ">=4.1.1",
      "lodash": ">=4.18.0",
      "micromatch": ">=4.0.8",
      "nanoid": ">=3.3.8",
      "tmp": ">=0.2.4",
      "yaml": ">=2.8.3",
      "ip": ">=2.0.1"
    }
  },
  "private": true,
  "scripts": {
    "build:all": "turbo build --log-order=grouped",
    "build:bbn": "turbo build --filter=bbn --log-order=grouped",
    "dev:bbn": "turbo dev --filter=bbn --filter=@ustrs/utils --filter=@ustrs/shadcn-ui",
    "format": "prettier --write '{apps,libs}/*/src/**/*.{ts,tsx,css}' --config ./.prettierrc",
    "gen": "turbo gen",
    "lint": "eslint '{apps,libs}/*/src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --fix '{apps,libs}/*/src/**/*.{jsx,ts,tsx}'",
    "prepare": "husky install",
    "pub:npm": "pnpm changeset version && pnpm install && pnpm publish -r --no-git-checks --access public",
    "storybook:ui": "turbo storybook --filter=@ustrs/shadcn-ui",
    "test:bbn": "turbo test --filter=bbn",
    "test:ui": "turbo test --filter=@ustrs/shadcn-ui",
    "test:watch:bbn": "pnpm --filter=bbn test:watch",
    "test:watch:ui": "pnpm --filter=@ustrs/shadcn-ui test:watch"
  },
  "volta": {
    "node": "20.17.0"
  }
}
